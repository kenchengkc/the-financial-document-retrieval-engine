# FDRE local environment template.
# Copy this file to `.env` for local development. Do not commit `.env`.

# App
APP_ENV=local
LOG_LEVEL=info
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=https://thefdre.com,https://www.thefdre.com,http://localhost:3000,http://127.0.0.1:3000
# Process-local protection for provider/DB-heavy routes. These limits multiply across workers.
API_EXPENSIVE_REQUESTS_PER_WINDOW=30
API_EXPENSIVE_WINDOW_SECONDS=60
API_EXPENSIVE_MAX_CALLERS=2048
API_EXPENSIVE_MAX_IN_FLIGHT=8
API_OVERLOAD_RETRY_AFTER_SECONDS=1

# Database
POSTGRES_DB=fdre
POSTGRES_USER=fdre
POSTGRES_PASSWORD=fdre
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_HOST_PORT=15432
DATABASE_URL=postgresql+psycopg://fdre:fdre@localhost:15432/fdre
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
# Applied with SET LOCAL to API request transactions only. Set 0 to disable.
DATABASE_STATEMENT_TIMEOUT_MS=30000
# Optional: direct Postgres URL for Alembic and long ingest jobs (Neon: non-pooler host).
# Ingest GitHub Actions use DATABASE_URL_DIRECT when set; API keeps DATABASE_URL pooled.
DATABASE_URL_DIRECT=

# SEC EDGAR
# The SEC requires a descriptive user agent. Use your own contact value locally.
SEC_USER_AGENT="FDRE local development contact@example.com"
SEC_CACHE_DIR=data/cache/sec
SEC_RATE_LIMIT_REQUESTS_PER_SECOND=5

# Retrieval and indexing
EMBEDDING_PROVIDER=local_hash
EMBEDDING_MODEL=local-hash-v1
EMBEDDING_DIMENSIONS=
EMBEDDING_BATCH_SIZE=128
# Voyage paid defaults: 2,000 RPM and 3,000,000 TPM. Lower for free tier (e.g. 2 RPM).
EMBEDDING_REQUESTS_PER_MINUTE=2000
EMBEDDING_TOKENS_PER_MINUTE=3000000
EMBEDDING_CONCURRENCY=8
# Set to the current provider price to include estimated query cost in benchmark reports.
EMBEDDING_COST_PER_MILLION_TOKENS=0
SPARSE_PROVIDER=postgres
RERANKER_PROVIDER=none
RERANK_TOP_N=50
# Snapshot company/ticker references instead of scanning all Company rows on every request.
COMPANY_REFERENCE_CACHE_TTL_SECONDS=300
COMPANY_REFERENCE_CACHE_STALE_IF_ERROR_SECONDS=3600

# Answer generation
ANSWER_GENERATOR=extractive
ANSWER_TOP_K=8
MIN_EVIDENCE_CHUNKS=2
MIN_RETRIEVAL_SCORE=0.2
# Cache deterministic console previews for six hours to avoid repeated Neon reads.
ANSWER_CACHE_TTL_SECONDS=21600
RESEARCH_CACHE_TTL_SECONDS=21600

# Optional paid or external providers.
# Leave unset for local deterministic operation and tests.
OPENAI_API_KEY=
VOYAGE_API_KEY=
OPENSEARCH_URL=
